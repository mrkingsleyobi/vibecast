# TrustSwarm Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# Blockchain Configuration
# =============================================================================

# Private key for contract deployment (DO NOT commit actual private key!)
# Generate a new wallet for development: https://vanity-eth.tk/
PRIVATE_KEY=your_private_key_here

# RPC URLs for different networks
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
OPTIMISM_RPC_URL=https://mainnet.optimism.io
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Block explorer API keys for contract verification
BASESCAN_API_KEY=your_basescan_api_key
OPTIMISTIC_ETHERSCAN_API_KEY=your_optimistic_etherscan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key

# Deployed contract addresses (filled after deployment)
NEXT_PUBLIC_TRUST_SCORE_NFT_ADDRESS=
NEXT_PUBLIC_PAYMENT_GUARD_ADDRESS=

# =============================================================================
# AI Model Configuration
# =============================================================================

# OpenRouter API key for multi-model access
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# Anthropic API key for Claude models
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI API key
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Google AI (Gemini) API key
# Get your key at: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key

# HuggingFace API token (optional, for downloading models)
# Get your token at: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token

# =============================================================================
# Database Configuration
# =============================================================================

# AgentDB path
AGENTDB_PATH=./data/trustswarm.db

# Redis connection (for caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# =============================================================================
# Application Configuration
# =============================================================================

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# API Configuration
API_PORT=3001
API_RATE_LIMIT=100

# JWT Secret for authentication
JWT_SECRET=your_random_secret_key_here

# =============================================================================
# MCP Server Configuration
# =============================================================================

# MCP Server Port
MCP_SERVER_PORT=3001
MCP_TRANSPORT=stdio,sse

# =============================================================================
# Monitoring & Analytics
# =============================================================================

# Sentry DSN for error tracking
# Get your DSN at: https://sentry.io/
SENTRY_DSN=

# Datadog API key for monitoring
DATADOG_API_KEY=

# PostHog API key for analytics
POSTHOG_API_KEY=

# =============================================================================
# External APIs
# =============================================================================

# CoinMarketCap API key for gas price reporting
COINMARKETCAP_API_KEY=

# Alchemy API key (alternative RPC provider)
ALCHEMY_API_KEY=

# =============================================================================
# Development & Testing
# =============================================================================

# Enable gas reporting in tests
REPORT_GAS=false

# Enable debug logging
DEBUG=false

# Test mode (uses mock data instead of real API calls)
TEST_MODE=true

# =============================================================================
# Security
# =============================================================================

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://trustswarm.ai

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
