{
  "name": "f1-strategy-optimizer-swarm",
  "version": "1.0.0",
  "description": "Next-generation F1 strategy optimizer using multi-agent swarm intelligence",
  "main": "swarm/orchestrator/index.js",
  "type": "module",
  "scripts": {
    "start": "node swarm/orchestrator/index.js",
    "dev": "nodemon swarm/orchestrator/index.js",
    "test": "jest",
    "simulate": "node swarm/orchestrator/simulate.js",
    "server": "node swarm/server/index.js",
    "server:dev": "nodemon swarm/server/index.js",
    "web": "cd web && npm run dev",
    "web:build": "cd web && npm run build",
    "web:install": "cd web && npm install",
    "setup": "npm install && npm run web:install",
    "build": "npm run web:build",
    "web-app": "concurrently \"npm run server:dev\" \"npm run web\""
  },
  "keywords": [
    "f1",
    "formula1",
    "strategy",
    "optimization",
    "swarm-intelligence",
    "multi-agent",
    "racing",
    "ai",
    "web-app",
    "real-time",
    "websocket"
  ],
  "author": "Vibecast Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "ws": "^8.14.0",
    "uuid": "^9.0.1",
    "date-fns": "^3.0.0",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "jest": "^29.7.0",
    "concurrently": "^8.2.2"
  }
}
